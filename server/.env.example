# AgentBlazer SMTP Email Configuration
# Optional: If configured, emails are dispatched live via SMTP.
# If not configured, emails are logged in the SQLite database (email_logs table) and admin portal.

# Option 1: Gmail
# SMTP_SERVICE=gmail
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password

# Option 2: Custom / SJEC Institutional SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=agentblazer@sjec.ac.in
# SMTP_PASS=your-smtp-password
# SMTP_FROM="AgentBlazer Club • SJEC CSE" <agentblazer@sjec.ac.in>
