# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (use a 64+ char random string in production)
JWT_SECRET=your-secure-random-jwt-secret-key-change-in-production

# CORS Configuration (comma-separated origins for production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Default Administrator Credentials (used during initial database seed)
ADMIN_DEFAULT_EMAIL=admin@agentblazer.ac.in
ADMIN_DEFAULT_PASSWORD=ChangeThisSecurePasswordInProduction!

# MongoDB Connection URI (for storing approved members)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# SMTP Email Configuration
# Option 1: Gmail
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Option 2: Custom / Institutional SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=agentblazer@sjec.ac.in
# SMTP_PASS=your-smtp-password
# SMTP_FROM="AgentBlazer Club • SJEC CSE" <agentblazer@sjec.ac.in>
